<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
    xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
                        http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
    name="${artifactId}">

  <fileSets>

    <!-- Root project files -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>pom.xml</include>
        <include>.gitignore</include>
        <include>CLAUDE.md</include>
      </includes>
    </fileSet>

    <!-- GitHub Actions workflow -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory>.github/workflows</directory>
      <includes>
        <include>ci.yml</include>
      </includes>
    </fileSet>

    <!-- Dependabot configuration -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory>.github</directory>
      <includes>
        <include>dependabot.yml</include>
      </includes>
    </fileSet>

    <!-- Main Java sources — placed under package directory -->
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>

    <!-- Jelly views and i18n messages — placed under package directory -->
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/resources</directory>
      <includes>
        <include>**/*.jelly</include>
        <include>**/*.properties</include>
        <include>**/*.html</include>
      </includes>
    </fileSet>

    <!-- Test Java sources — placed under package directory -->
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/test/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>

  </fileSets>
</archetype-descriptor>
