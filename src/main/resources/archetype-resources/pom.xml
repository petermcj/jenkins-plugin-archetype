<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <!-- Renovate/Dependabot will keep this current. Requires JDK 17 and Jenkins 2.479+. -->
    <version>5.7</version>
    <relativePath/>
  </parent>

  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <!--
    CI-friendly incremental version: revision is the base (e.g. "1.0"), changelist
    is "-SNAPSHOT" locally and "-rc<N>.<sha>" on ci.jenkins.io.
    See https://github.com/jenkinsci/incrementals-tools
  -->
  <version>${revision}${changelist}</version>
  <packaging>hpi</packaging>

  <name>${artifactId}</name>
  <description>A Jenkins plugin</description>

  <properties>
    <!-- Incrementals versioning — do not change these property names. -->
    <revision>1.0</revision>
    <changelist>-SNAPSHOT</changelist>

    <!-- Target Jenkins LTS version. Update to the latest LTS release. -->
    <jenkins.version>2.504.1</jenkins.version>
  </properties>

  <!--
    Dependencies are version-managed by the Jenkins BOM included in the parent POM.
    Add plugin dependencies below as needed — omit <version> tags; BOM manages them.

    Example — Pipeline support:
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
      <optional>true</optional>
    </dependency>
  -->
  <dependencies/>

  <build>
    <plugins>
      <!--
        Resolves ${revision}${changelist} in the installed/deployed POM so
        downstream consumers see a concrete version string.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals><goal>clean</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <scm>
    <connection>scm:git:https://github.com/${groupId}/${artifactId}-plugin.git</connection>
    <developerConnection>scm:git:https://github.com/${groupId}/${artifactId}-plugin.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${groupId}/${artifactId}-plugin</url>
  </scm>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

</project>
