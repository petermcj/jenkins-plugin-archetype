<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Prompt}" field="prompt">
    <f:textarea rows="4"
                placeholder="Describe the task for the AI agent…"/>
  </f:entry>
  <f:entry title="${%Model}" field="model">
    <f:textbox default="claude-opus-4-7"
               checkMessage="Enter a valid model identifier"/>
  </f:entry>
  <f:entry title="${%Max Tokens}" field="maxTokens">
    <f:number min="1" max="100000" step="1"/>
  </f:entry>
</j:jelly>
